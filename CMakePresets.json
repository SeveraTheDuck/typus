{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev (Debug)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (LTO)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "typus_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "dev-asan",
      "displayName": "Dev + ASan/UBSan",
      "inherits": "dev",
      "cacheVariables": {
        "typus_ENABLE_ASAN": "ON",
        "typus_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "dev-tsan",
      "displayName": "Dev + TSan",
      "inherits": "dev",
      "cacheVariables": { "typus_ENABLE_TSAN": "ON" }
    },
     {
       "name": "coverage",
       "displayName": "Coverage (Debug + instrumentation)",
       "inherits": "dev",
       "cacheVariables": { "typus_ENABLE_COVERAGE": "ON" }
     }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "dev-asan", "configurePreset": "dev-asan" },
    { "name": "dev-tsan", "configurePreset": "dev-tsan" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "dev-asan", "configurePreset": "dev-asan", "output": { "outputOnFailure": true } },
    { "name": "dev-tsan", "configurePreset": "dev-tsan", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
